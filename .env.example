# GEMINI_API_KEY: Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# OPENAI_API_KEY: Optional OpenAI API key for GPT-4o / GPT-4o-mini
OPENAI_API_KEY=""

# ANTHROPIC_API_KEY: Optional Anthropic API key for Claude 3.7 / 3.5 Sonnet & Haiku
ANTHROPIC_API_KEY=""

# OPENROUTER_API_KEY: Optional OpenRouter API key for multi-model routing
OPENROUTER_API_KEY=""

# GROQ_API_KEY: Optional Groq API key for ultra-fast Llama/Mixtral inference
GROQ_API_KEY=""

# GEOAPIFY_API_KEY: Required for lead scraping.
# Obtain from https://myprojects.geoapify.com/
GEOAPIFY_API_KEY="MY_GEOAPIFY_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
